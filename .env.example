PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_API_KEY=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Your Telegram numeric user ID. Only this ID can use admin commands.
TELEGRAM_ADMIN_ID=PUT_YOUR_TELEGRAM_USER_ID_HERE

# Optional: used for generating absolute API URLs in examples
PUBLIC_BASE_URL=http://localhost:3000
